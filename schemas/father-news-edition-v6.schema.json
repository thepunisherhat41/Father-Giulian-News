{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father-giulian-news-livid.vercel.app/schemas/father-news-edition-v6.schema.json",
  "title": "Father News edition snapshot v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "editionId",
    "editionDate",
    "timezone",
    "revision",
    "generatedAt",
    "cards",
    "mediaCatalog",
    "omissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "editionId": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-r\\d{2,}$"
    },
    "editionDate": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "const": "America/Sao_Paulo"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "appMinSchemaVersion": {
      "type": "integer",
      "minimum": 6
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "mediaCatalog": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/media"
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "reason"
        ],
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "editorialNote": {
      "type": "string"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "publisher": {
          "type": "string"
        },
        "publishedOn": {
          "type": "string",
          "format": "date",
          "description": "Publisher-confirmed date only, with no invented clock time"
        },
        "undatedReason": {
          "type": "string",
          "minLength": 12,
          "description": "Only for background material, never proof of dated news"
        }
      },
      "oneOf": [
        {
          "required": [
            "publishedAt"
          ]
        },
        {
          "required": [
            "publishedOn"
          ]
        },
        {
          "required": [
            "undatedReason"
          ]
        }
      ]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "order",
        "kind",
        "title",
        "summary",
        "details",
        "eventDate",
        "reportedAt",
        "sources",
        "mediaId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "section": {
          "type": "string",
          "minLength": 2
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "FATO",
            "AGENDA",
            "PESQUISA",
            "DECLARAÇÃO",
            "APURAÇÃO/REPORTAGEM",
            "ATUALIZAÇÃO",
            "RUMOR",
            "PREVISÃO",
            "GUIA",
            "CURIOSIDADE",
            "ATIVIDADE"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 16
        },
        "summary": {
          "type": "string",
          "minLength": 40
        },
        "details": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "eventDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "reportedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "mediaId": {
          "type": "string",
          "minLength": 1
        },
        "visualConceptId": {
          "type": "string"
        },
        "layout": {
          "enum": [
            "quest",
            "discover",
            "spotlight",
            "guide"
          ]
        },
        "questXp": {
          "type": "integer",
          "minimum": 0
        },
        "quiz": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "options",
            "answer",
            "explanation"
          ],
          "properties": {
            "question": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            },
            "answer": {
              "type": "integer",
              "minimum": 0
            },
            "explanation": {
              "type": "string"
            }
          }
        },
        "reportedOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "conceptId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url",
        "sha256",
        "mimeType",
        "alt",
        "credit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "video",
            "image",
            "art"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mimeType": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/avif",
            "video/mp4",
            "video/webm"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 12
        },
        "credit": {
          "type": "string",
          "minLength": 3
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
